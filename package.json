{
  "name": "homepilot",
  "version": "0.1.0",
  "description": "HomePilot: local-first personal assistant core (tasks, reminders, nudges, policy, model telemetry). Phase 1 MVP.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "homepilot": "bin/homepilot"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "homepilot": "tsx src/cli.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "luxon": "^3.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
