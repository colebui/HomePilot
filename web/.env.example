# Copy to .env.local. Leave everything unset for demo mode.

# live | demo (default: live when a token is set)
# HOMEPILOT_MODE=live

# Where the HomePilot service listens
# HOMEPILOT_API_URL=http://127.0.0.1:8787

# Same value as HOMEPILOT_API_TOKEN in the service's .env
# HOMEPILOT_API_TOKEN=

# Optional: signs dashboard sessions (32+ characters). Defaults to a key derived from the token.
# DASHBOARD_SESSION_SECRET=
