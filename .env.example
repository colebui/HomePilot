# HomePilot configuration. Copy to .env and edit. PLACEHOLDERS ONLY: never commit a real .env.
# Everything below has a safe default; with no .env at all HomePilot runs fully offline with a mock model.

# --- Core -------------------------------------------------------------------
HOMEPILOT_DB_PATH=./data/homepilot.db
HOMEPILOT_TIMEZONE=America/Chicago
# true = tools never perform live side effects and notifications go to the local outbox only.
HOMEPILOT_DRY_RUN=true
# Comma-separated identities allowed to issue commands. "local-cli" is the terminal user.
HOMEPILOT_ALLOWED_SENDERS=local-cli
# Channels where an AI agent relays your words. Approvals and "resume" are refused on these.
HOMEPILOT_AGENT_CHANNELS=openclaw
# true = when a model (not plain code) understood your message, the reply ends with "(read by <model>)".
HOMEPILOT_REPLY_SHOWS_MODEL=true

# --- Nudges -----------------------------------------------------------------
HOMEPILOT_QUIET_HOURS_START=22:00
HOMEPILOT_QUIET_HOURS_END=08:00
HOMEPILOT_MAX_NUDGES_PER_DAY=3
HOMEPILOT_NUDGE_COOLDOWN_MINUTES=240
HOMEPILOT_NUDGE_INTERVAL_MINUTES=30

# --- Models -----------------------------------------------------------------
# mock = no network, no key, no cost (default). openrouter = real calls, real money.
HOMEPILOT_MODEL_PROVIDER=mock
# Preferred on macOS: store the key in Keychain instead of this file (see README "Credentials").
# OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# Comma-separated: primary first, then fallbacks. IDs below were seen in the OpenRouter catalog on
# 2026-11-16; they are examples, not recommendations. Run `npm run homepilot -- models sync` to refresh prices.
HOMEPILOT_MODEL_FAST=deepseek/deepseek-v4.1-flash-1017,tencent/hy4-flash
HOMEPILOT_MODEL_BALANCED=openai/gpt-6.1-terra,google/gemini-4-hydrogen
HOMEPILOT_MODEL_PREMIUM=anthropic/claude-fable-5.2
HOMEPILOT_LLM_TIMEOUT_MS=20000
HOMEPILOT_LLM_MAX_RETRIES=1
HOMEPILOT_LLM_MAX_CONCURRENCY=2
HOMEPILOT_LLM_MAX_OUTPUT_TOKENS=1024

# --- Cost controls ----------------------------------------------------------
HOMEPILOT_MONTHLY_BUDGET_USD=20
# Optional budget for personal expenses you text in ("spent $23 at H-E-B"). 0 = no budget.
HOMEPILOT_SPENDING_BUDGET_USD=0
HOMEPILOT_BUDGET_ALERT_THRESHOLDS=0.5,0.8,1.0
# Claude API model used for the hypothetical "everything on Claude" baseline.
HOMEPILOT_BASELINE_MODEL=claude-opus-5-5

# --- Policy -----------------------------------------------------------------
# approve = Tier B actions (calendar writes, cart changes) need approval. auto = allowed once the scope is granted.
HOMEPILOT_TIER_B_MODE=approve
HOMEPILOT_APPROVAL_TTL_MINUTES=15

# --- Local dashboard / API (binds to 127.0.0.1 only) ---------------------------
HOMEPILOT_API_PORT=8787
# Turns on the dashboard (in `run`, or `serve`). Generate one with: openssl rand -hex 32
# HOMEPILOT_API_TOKEN=REPLACE_ME

# --- iMessage (macOS only; see docs/operations.md "iMessage setup") ---------
# Texts are read and answered while `homepilot run` is running. Add your own phone number or
# Apple ID email to HOMEPILOT_ALLOWED_SENDERS above, e.g. local-cli,+15555550100
HOMEPILOT_IMESSAGE_ENABLED=false
HOMEPILOT_IMSG_PATH=imsg
# Where reminders and nudges are texted (normally the same handle as above). Not a secret, but
# personal: .env is git-ignored. Texts are only sent when HOMEPILOT_DRY_RUN=false.
# HOMEPILOT_NOTIFY_HANDLE=+15555550100
HOMEPILOT_IMESSAGE_MAX_PER_HOUR=30

# --- Phase 2 (NOT IMPLEMENTED YET; listed so you know what is coming) ---------
# GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME
